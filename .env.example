# Mule Matrix — Environment Configuration
# Copy this file to .env and fill in your values

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mule_matrix
DB_USER=root
DB_PASSWORD=your_password_here

# Application
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_ENV=development
APP_DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend (used at build time)
VITE_API_BASE_URL=http://localhost:8000

# Monitoring
MONITORING_POLL_INTERVAL_SECONDS=2
HIGH_VALUE_THRESHOLD=1000000

# Synthetic Generator
DEFAULT_SEED=42
DEFAULT_NUM_ACCOUNTS=60
DEFAULT_NUM_TRANSACTIONS=500
DEFAULT_TIMESPAN_DAYS=30
